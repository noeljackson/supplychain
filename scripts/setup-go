#!/usr/bin/env bash
set -euo pipefail

# Keep this release and checksum in lockstep with go.mod. We install into a
# run-unique directory rather than the shared Go-version cache slot: scoped
# push and PR workflows can start simultaneously on the same Gitea runner.
readonly GO_VERSION='1.26.5'
readonly GO_ARCHIVE_URL='https://go.dev/dl/go1.26.5.linux-amd64.tar.gz'
readonly GO_ARCHIVE_SHA256='5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053'

if [[ "${RUNNER_OS:-Linux}" != 'Linux' || "$(uname -m)" != 'x86_64' ]]; then
  printf 'supplychain action supports Linux x86_64 runners only\n' >&2
  exit 1
fi

: "${RUNNER_TEMP:=/tmp}"
: "${GITHUB_RUN_ID:=local}"
: "${GITHUB_RUN_ATTEMPT:=1}"

if [[ -n "${RUNNER_TOOL_CACHE:-}" ]]; then
  tool_root="$RUNNER_TOOL_CACHE"
elif [[ -n "${HOME:-}" ]]; then
  tool_root="${HOME}/.cache"
else
  printf 'no executable tool-cache directory is available\n' >&2
  exit 1
fi
run_key="${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
if [[ ! "$run_key" =~ ^[[:alnum:]._-]+$ ]]; then
  printf 'runner supplied an unsafe Go bootstrap key\n' >&2
  exit 1
fi

install_root="${tool_root}/supplychain-go/${GO_VERSION}/${run_key}"
goroot="${install_root}/go"

valid_goroot() {
  [[ -x "${goroot}/bin/go" ]] || return 1
  local actual_version
  actual_version="$("${goroot}/bin/go" version)"
  case "$actual_version" in
    "go version go${GO_VERSION} "*) return 0 ;;
    *) return 1 ;;
  esac
}

if ! valid_goroot; then
  mkdir -p "$(dirname -- "$install_root")"
  temp_dir="$(mktemp -d "${RUNNER_TEMP}/supplychain-go-download.XXXXXXXX")"
  cleanup() {
    rm -rf -- "$temp_dir"
  }
  trap cleanup EXIT

  archive="${temp_dir}/go.tgz"
  curl --fail --location --silent --show-error --retry 5 --retry-delay 2 "$GO_ARCHIVE_URL" --output "$archive"
  printf '%s  %s\n' "$GO_ARCHIVE_SHA256" "$archive" | sha256sum --check --status

  rm -rf -- "$goroot"
  mkdir -p "$install_root"
  tar --extract --gzip --file "$archive" --directory "$install_root"
  chmod 0755 "${goroot}/bin/go"
  valid_goroot || {
    printf 'pinned Go installation is incomplete or has the wrong version\n' >&2
    exit 1
  }
fi

if [[ -n "${GITHUB_PATH:-}" ]]; then
  printf '%s\n' "${goroot}/bin" >>"$GITHUB_PATH"
fi

"${goroot}/bin/go" version
